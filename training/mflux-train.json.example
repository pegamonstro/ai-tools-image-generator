{
  "_comment": "mflux-train config for the patched 0.15.5 training venv (see training/README.md). Training loop length = num_epochs x number_of_images; 'steps' is only the sampler/sigma count and does not bound the run. output_path is resolved relative to the working directory mflux-train is launched from.",
  "model": "dev",
  "model_path": "~/mflux-models/<base-model-dir>",
  "seed": 42,
  "steps": 700,
  "guidance": 3.5,
  "quantize": 4,
  "width": 512,
  "height": 704,
  "training_loop": {
    "num_epochs": 15,
    "batch_size": 1
  },
  "optimizer": {
    "name": "AdamW",
    "learning_rate": 0.0001
  },
  "save": {
    "checkpoint_frequency": 100,
    "output_path": "out/<slug>"
  },
  "instrumentation": {
    "plot_frequency": 20,
    "generate_image_frequency": 100,
    "validation_prompt": "<trigger>, full body studio photo, natural light"
  },
  "lora_layers": {
    "transformer_blocks": {
      "block_range": { "start": 0, "end": 19 },
      "layer_types": [
        "attn.to_q",
        "attn.to_k",
        "attn.to_v",
        "attn.add_q_proj",
        "attn.add_k_proj",
        "attn.add_v_proj",
        "attn.to_out",
        "attn.to_add_out",
        "ff.linear1",
        "ff.linear2",
        "ff_context.linear1",
        "ff_context.linear2"
      ],
      "lora_rank": 16
    },
    "single_transformer_blocks": {
      "block_range": { "start": 0, "end": 38 },
      "layer_types": [
        "proj_out",
        "proj_mlp",
        "attn.to_q",
        "attn.to_k",
        "attn.to_v"
      ],
      "lora_rank": 16
    }
  },
  "examples": {
    "path": "datasets/<slug>/",
    "images": [
      { "image": "<file01>.jpg", "prompt": "<trigger>, <caption text>" },
      { "image": "<file02>.jpg", "prompt": "<trigger>, <caption text>" }
    ]
  }
}