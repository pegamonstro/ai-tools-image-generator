{
  "_comment": "mflux-train config template (mflux 0.20 TrainingSpec schema). Copy to training/<slug>.train.json, set data and model, then validate with: mflux-train --dry-run --config training/<slug>.train.json. Relative data/output paths resolve against this file's directory.",
  "model": "dev",
  "model_path": null,
  "seed": 42,
  "steps": 700,
  "guidance": 3.5,
  "quantize": 4,
  "max_resolution": 1024,
  "low_ram": false,
  "gradient_checkpointing": false,
  "training_loop": {
    "num_epochs": 50,
    "batch_size": 1,
    "timestep_type": "sigmoid"
  },
  "optimizer": {
    "name": "AdamW",
    "learning_rate": 1e-4,
    "lr_schedule": "cosine",
    "lr_warmup_steps": 20
  },
  "checkpoint": {
    "save_frequency": 100,
    "output_path": "out/<slug>"
  },
  "monitoring": {
    "plot_frequency": 20,
    "generate_image_frequency": 100,
    "preview_width": 512,
    "preview_height": 512
  },
  "lora_layers": {
    "targets": [
      { "module_path": "transformer_blocks.{block}.attn.to_q", "blocks": { "start": 0, "end": 19 }, "rank": 16 },
      { "module_path": "transformer_blocks.{block}.attn.to_k", "blocks": { "start": 0, "end": 19 }, "rank": 16 },
      { "module_path": "transformer_blocks.{block}.attn.to_v", "blocks": { "start": 0, "end": 19 }, "rank": 16 },
      { "module_path": "transformer_blocks.{block}.attn.to_out.0", "blocks": { "start": 0, "end": 19 }, "rank": 16 },
      { "module_path": "single_transformer_blocks.{block}.attn.to_q", "blocks": { "start": 0, "end": 38 }, "rank": 16 },
      { "module_path": "single_transformer_blocks.{block}.attn.to_k", "blocks": { "start": 0, "end": 38 }, "rank": 16 },
      { "module_path": "single_transformer_blocks.{block}.attn.to_v", "blocks": { "start": 0, "end": 38 }, "rank": 16 }
    ]
  },
  "data": "datasets/<slug>/"
}